# Application security
# Generate two different random strings of at least 32 characters.
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-a-different-at-least-32-random-key
JWT_EXPIRES_HOURS=12

# Alibaba Cloud Bailian
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=deepseek-v4-flash
DASHSCOPE_ENABLE_THINKING=false
DASHSCOPE_MULTIMODAL_UNDERSTAND_MODEL=qwen3.6-flash
DASHSCOPE_TEXT2IMAGE_MODEL=wanx2.0-t2i-turbo
DASHSCOPE_TEXT2VIDEO_MODEL=wan2.6-t2v
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
USE_REMOTE_LLM=auto
USE_LANGCHAIN_AGENT=false
LLM_MULTIMODAL_TIMEOUT=600

# MiMo chat, ASR and TTS
MIMO_API_KEY=
MIMO_BASE_URL=https://fufu.iqach.top/v1
MIMO_CHAT_MODEL=mimo-v2.5
MIMO_CHAT_TIMEOUT=45
MIMO_CODE_MODEL=mimo-v2.5
MIMO_CODE_TIMEOUT=45
MIMO_DIGITAL_HUMAN_MODEL=mimo-v2.5
MIMO_DIGITAL_HUMAN_TIMEOUT=20
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_ASR_LANGUAGE=zh
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_DEFAULT_VOICE=
MIMO_TTS_TIMEOUT=15
VOICE_CHUNK_MS=5000
QUIZ_OPEN_ANSWER_TIMEOUT=6

# Data enrichment and learning features
MINDMAP_MODEL_API_URL=https://ai-mindmap.app/api/imports
ENABLE_AUTO_PATH_RESOURCES=false
ENABLE_PARALLEL_RESOURCE_GEN=true
ENABLE_EVAL_HISTORY_REF=true
ENABLE_PATH_LEARNED_TRACKING=true
ENABLE_QUIZ_WEAK_POINTS_PRIORITY=true
ENABLE_TUTOR_LEARNING_RECORD=true
DIGITAL_HUMAN_ENABLED=true

# Database. Remove MYSQL_HOST to use local SQLite.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=study_ai
MYSQL_USER=root
MYSQL_PASSWORD=replace-me

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# iFlytek PPT
XFYUN_APP_ID=
XFYUN_API_SECRET=

# Optional Bilibili login Cookie. Leave empty for anonymous requests.
BILI_COOKIE=

# Code runner
PISTON_API_URL=http://localhost:2000
CODE_RUN_TIMEOUT_SECONDS=15
CODE_RUN_MAX_OUTPUT_CHARS=20000
# Development/tests may create missing tables automatically. Set false in production.
AUTO_CREATE_DB=true
